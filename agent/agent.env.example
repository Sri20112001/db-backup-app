# VaultGuard agent — copy to `agent/agent.env` and fill in real values.
# The agent reads process env directly; with most shells you can run:
#   set -a; source agent.env; set +a   (or export each line on Windows)
# Never commit `agent.env` (it holds database passwords).

# VaultGuard server API base (no trailing slash).
AGENT_SERVER=http://localhost:7541/vaultguard/api

# One-time key from Dashboard → Agents → Register Agent (first run only;
# after that the agent reuses AGENT_STATE_FILE).
#AGENT_REGISTRATION_KEY=
#AGENT_STATE_FILE=./agent-state.json
#AGENT_HOSTNAME=
#AGENT_POLL_INTERVAL=30s
#AGENT_JOB_TIMEOUT=6h

# Folder browser used by the dashboard picker (same-machine only).
#AGENT_BROWSE_ADDR=127.0.0.1:7546
#AGENT_BROWSE_TOKEN=change-me
#AGENT_DASHBOARD_ORIGIN=http://localhost:7540

# Local PostgreSQL the agent backs up.
AGENT_PG_HOST=localhost
AGENT_PG_PORT=5432
AGENT_PG_USER=postgres
AGENT_PG_PASSWORD=change-me

# SQL Server the agent backs up (optional).
#AGENT_MSSQL_SERVER=
#AGENT_MSSQL_USER=
#AGENT_MSSQL_PASSWORD=
#AGENT_MSSQL_BACKUP_DIR=

# MongoDB the agent backs up (optional).
#AGENT_MONGO_URI=mongodb://localhost:27017

# Accept self-signed/lab server certificates (default false — prefer
# trusting the server CA in production).
#AGENT_TLS_SKIP_VERIFY=false
