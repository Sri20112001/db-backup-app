# VaultGuard API — copy to `server/.env` and fill in real values.
# Loaded automatically by `air` AND by plain `go run` (dev convenience).
# Never commit `.env`. Generate secrets with:  openssl rand -hex 32
PORT=7541
GRPC_PORT=9090
CORS_ORIGIN=http://localhost:7540

DATABASE_URL=host=localhost user=postgres password=change-me dbname=db_backup port=5432 sslmode=disable

JWT_SECRET=change-me-64-hex-chars
JWT_REFRESH_SECRET=change-me-64-hex-chars
ENCRYPTION_KEY=change-me-64-hex-chars

# ── Optional ────────────────────────────────────────────────────────────────
# Alert emails (empty SMTP_HOST disables email; alerts are still recorded).
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_FROM=
# Token lifetimes.
#ACCESS_TOKEN_TTL_MINUTES=60
#REFRESH_TOKEN_TTL_DAYS=7
# HTTPS (set both to serve TLS directly; empty = plain HTTP).
#TLS_CERT_FILE=
#TLS_KEY_FILE=
