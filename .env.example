# VaultGuard — copy to `.env` (repo root) and fill in real values.
# Used ONLY for `docker compose` variable interpolation. Never commit `.env`.
#
# Generate secrets with: openssl rand -hex 32   (JWT_*)  /  16 (password)

# PostgreSQL superuser password for the compose `postgres` service (wired
# into the server DATABASE_URL only — the agent never gets this).
POSTGRES_PASSWORD=change-me-16-chars-min

# Least-privilege backup role consumed by the agent (created by
# postgres-init/01-backup-role.sh on first init; see SOP.md for existing
# volumes and external databases).
BACKUP_DB_USER=vaultguard_backup
BACKUP_DB_PASSWORD=change-me-16-chars-min

# Server auth + encryption secrets (each `openssl rand -hex 32`).
JWT_SECRET=change-me-64-hex-chars
JWT_REFRESH_SECRET=change-me-64-hex-chars
ENCRYPTION_KEY=change-me-64-hex-chars
