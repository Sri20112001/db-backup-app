# Relative base URL so the dashboard works on localhost, LAN IPs, and behind
# the docker nginx reverse proxy (which forwards /vaultguard/api/ to the
# server). In `npm run dev`, vite.config.ts proxies this path to
# http://localhost:7541. Override with an absolute URL only if the API lives
# on a different origin (then ensure server CORS_ORIGIN allows it).
VITE_API_URL=/vaultguard/api
# VITE_AGENT_BROWSE_URL=http://127.0.0.1:7546
